# ---------------------------------------------------------------- database
# Supabase → Project Settings → Database → Connection string
# Pooled connection (port 6543) for the app; direct (5432) for migrations.
DATABASE_URL="postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres"
DIRECT_DATABASE_URL="postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# ------------------------------------------------------------------- auth
# Signs admin session cookies. Generate with: openssl rand -base64 32
AUTH_SECRET=""

# ---------------------------------------------------------------- storage
# Supabase → Project Settings → API
SUPABASE_URL="https://PROJECT.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""   # SERVER ONLY — never expose to the browser
STORAGE_BUCKET="resumes"       # must be a PRIVATE bucket

# ------------------------------------------------------------------ email
# Configure either Resend or SMTP. If neither is set, sends are logged and
# skipped — applications still submit successfully.
EMAIL_FROM="Sohum Systems <careers@sohumsystems.com>"
ADMIN_EMAIL="hr@sohumsystems.com"

RESEND_API_KEY=""

# SMTP alternative (included in dependencies)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""

# --------------------------------------------------------------- app / limits
NEXT_PUBLIC_APP_URL="http://localhost:3000"
RATE_LIMIT_APPLICATIONS_PER_HOUR="5"
DUPLICATE_APPLICATION_WINDOW_DAYS="30"

# Private offer PDF bucket; create it in the same Supabase project.
STORAGE_BUCKET_OFFERS="offers"
# Private invoice PDF bucket; create it in the same Supabase project.
STORAGE_BUCKET_INVOICES="invoices"

# Optional local Chrome path for PDF generation; Linux/Vercel uses bundled Chromium.
CHROME_EXECUTABLE_PATH=""
# NEXT_PUBLIC_APP_URL must be the deployed recruiting app origin; offer links use it.
